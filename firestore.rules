rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.uid == request.auth.uid
        && data.uid == userId
        && data.hearts is number
        && data.hearts >= 0
        && data.hearts <= 10
        && data.gems is number
        && data.gems >= 0
        && data.xp is number
        && data.xp >= 0
        && data.streak is number
        && data.streak >= 0
        && (!('completedLessonIds' in data) || data.completedLessonIds is list)
        && (!('theme' in data) || (data.theme is string && (data.theme == 'light' || data.theme == 'dark')))
        && (!('notificationPreferences' in data) || data.notificationPreferences is map);
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile documents - each user can only read and write their own document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if false;
    }
  }
}
